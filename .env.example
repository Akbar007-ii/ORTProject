# Copy to .env (local) or .env.prod (server) and fill in. Never commit these files.

# At least 32 random characters: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://orto:orto_dev@localhost:5433/orto
# Leave empty to use the in-memory rate limiter (single process only).
REDIS_URL=redis://localhost:6380/0

# Only for docker-compose.prod.yml: database password, the API domain (DNS must point to the
# server; Caddy gets the HTTPS certificate for it), and staging|production
# (staging keeps /docs open for the frontend team).
POSTGRES_PASSWORD=
API_DOMAIN=

# Website address (links in emails) and the origins allowed to call the API.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Email over SMTP. Empty SMTP_HOST: mail is only logged locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=ORTO <no-reply@example.com>

# AI tutor (optional). Without a key the tutor returns the verified solution.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5

# Telegram bot and reminders (optional): python -m mysite.bot, python -m mysite.worker
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
